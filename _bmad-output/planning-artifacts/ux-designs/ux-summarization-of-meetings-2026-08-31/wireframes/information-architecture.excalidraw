      "groupIds": [], "frameId": null, "roundness": null, "seed": 129, "version": 1, "versionNonce": 1029, "isDeleted": false, "boundElements": null, "updated": 1788210000000, "link": null, "locked": false, "index": "aS",
      "text": "MODAL · УДАЛЕНИЕ\n\nВариант 1:\nудалить исходную запись,\nсохранить текстовые результаты\n\nВариант 2:\nполностью удалить Встречу\n\nПеречислить все материалы\nи объём; явное подтверждение", "fontSize": 19, "fontFamily": 5, "textAlign": "left", "verticalAlign": "top", "baseline": 245, "containerId": null, "originalText": "MODAL · УДАЛЕНИЕ\n\nВариант 1:\nудалить исходную запись,\nсохранить текстовые результаты\n\nВариант 2:\nполностью удалить Встречу\n\nПеречислить все материалы\nи объём; явное подтверждение", "lineHeight": 1.25
    },
