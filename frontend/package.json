{
  "name": "meeting-app-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": "24.20.0",
    "pnpm": "11.1.3"
  },
  "scripts": {
    "generate:api": "openapi-typescript ../openapi/openapi.json -o src/api/generated/schema.ts",
    "test:policy": "node --test tests/source-policy.test.mjs",
    "test:unit": "vitest run",
    "test": "pnpm run generate:api && pnpm run test:policy && pnpm run test:unit",
    "build": "pnpm run generate:api && tsc -b && vite build"
  },
  "dependencies": {
    "antd": "6.6.2",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "jsdom": "30.0.1",
    "openapi-typescript": "7.13.0",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
